PACKAGE_NAME="nvidia-gp104-r580"
PACKAGE_VERSION="580.178.04"
AUTOINSTALL="yes"

# Quoting 'make' prevents dkms(8) from passing KERNELRELEASE implicitly, which
# breaks NVIDIA's custom Kbuild / conftest.sh invocation across Linux 7.x kernels.
MAKE[0]="'make' -j__JOBS NV_EXCLUDE_BUILD_MODULES='nvidia-peermem' SYSSRC=\"${kernel_source_dir}\" KERNEL_UNAME=\"${kernelver}\" modules"
CLEAN="make KERNEL_UNAME=${kernelver} clean"

BUILT_MODULE_NAME[0]="nvidia"
BUILT_MODULE_LOCATION[0]="./"
DEST_MODULE_LOCATION[0]="/updates/dkms"

BUILT_MODULE_NAME[1]="nvidia-modeset"
BUILT_MODULE_LOCATION[1]="./"
DEST_MODULE_LOCATION[1]="/updates/dkms"

BUILT_MODULE_NAME[2]="nvidia-uvm"
BUILT_MODULE_LOCATION[2]="./"
DEST_MODULE_LOCATION[2]="/updates/dkms"

BUILT_MODULE_NAME[3]="nvidia-drm"
BUILT_MODULE_LOCATION[3]="./"
DEST_MODULE_LOCATION[3]="/updates/dkms"

