# Headless NVIDIA Tesla P4 (10de:1bb3) device node permissions and persistence rule.
# Keeps integrated GPUs (e.g. i915 renderD128/card1) untouched for display handoff.

SUBSYSTEM=="pci", ACTION=="add|bind", ATTR{vendor}=="0x10de", ATTR{device}=="0x1bb3", \
  TEST=="/sys/bus/pci/drivers/nvidia", RUN+="/sbin/modprobe nvidia-uvm"

# Ensure compute/encode/decode/modeset device nodes remain accessible cleanly across host users and containers.
KERNEL=="nvidia[0-9]*", MODE="0666"
KERNEL=="nvidiactl", MODE="0666"
KERNEL=="nvidia-uvm*", MODE="0666"
KERNEL=="nvidia-modeset", MODE="0666"
KERNEL=="nvidia-caps*", MODE="0666"

